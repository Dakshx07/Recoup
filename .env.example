# ==============================================================================
# RECOUP — Environment Configuration Template
# Copy this file to `.env.local` and replace the placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (from Supabase Dashboard → Project Settings → API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key (SERVER-SIDE ONLY — bypasses RLS for state transitions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Direct Postgres Connection (from Supabase Dashboard → Settings → Database)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Google Gemini API Key (from https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. Razorpay Test Mode Credentials (from https://dashboard.razorpay.com/app/keys)
# ------------------------------------------------------------------------------
# Public Key ID — used by frontend Razorpay Standard Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...

# Razorpay Key Secret — SERVER-SIDE ONLY (Used for Order creation API)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret — SERVER-SIDE ONLY (Configured in Razorpay Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Application Settings
# ------------------------------------------------------------------------------
# Clock mode — 'DEMO' for simulated business clock evaluation, 'LIVE' for real-time UTC
CLOCK_MODE=DEMO

# Node environment
NODE_ENV=development
